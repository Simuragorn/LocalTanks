/*
 * LocalTanks UI foundation.
 *
 * Player-facing UXML/USS screens import this file before their component sheet and compose these
 * semantic classes instead of inventing another panel, text or button treatment. The intentionally
 * restrained palette leaves saturated colours to gameplay meaning: teams, damage and warnings.
 */

.lt-panel {
    background-color: rgba(12, 15, 13, 0.88);
    border-width: 1px;
    border-color: rgba(205, 210, 200, 0.26);
    border-radius: 3px;
}

.lt-panel--solid {
    background-color: rgba(12, 15, 13, 0.98);
    border-color: rgba(214, 219, 208, 0.38);
}

.lt-panel--quiet {
    background-color: rgba(12, 15, 13, 0.86);
}

.lt-title {
    color: rgb(239, 241, 235);
    font-size: 20px;
    -unity-font-style: bold;
}

.lt-section-title {
    color: rgb(174, 190, 169);
    font-size: 12px;
    -unity-font-style: bold;
}

.lt-label {
    color: rgb(226, 229, 221);
    font-size: 14px;
}

.lt-caption {
    color: rgb(174, 180, 171);
    font-size: 12px;
}

.lt-value {
    color: rgb(238, 240, 234);
    font-size: 14px;
    -unity-font-style: bold;
}

.lt-divider {
    height: 1px;
    background-color: rgba(205, 210, 200, 0.18);
}

.lt-meter-track {
    background-color: rgba(4, 6, 5, 0.92);
    border-width: 1px;
    border-color: rgba(205, 210, 200, 0.22);
    border-radius: 1px;
}

.lt-button {
    min-height: 34px;
    padding-left: 14px;
    padding-right: 14px;
    color: rgb(230, 233, 225);
    background-color: rgba(49, 56, 50, 0.98);
    border-width: 1px;
    border-color: rgba(211, 216, 205, 0.34);
    border-radius: 3px;
    font-size: 13px;
    -unity-text-align: middle-center;
}

.lt-button:hover {
    color: rgb(244, 246, 240);
    background-color: rgba(65, 74, 66, 0.98);
    border-color: rgba(222, 226, 216, 0.54);
}

.lt-button:active {
    background-color: rgba(38, 44, 39, 0.98);
    border-color: rgba(177, 188, 173, 0.56);
}

.lt-button:focus {
    border-color: rgb(151, 171, 145);
}

.lt-button:disabled {
    color: rgba(205, 208, 200, 0.46);
    background-color: rgba(39, 43, 39, 0.78);
    border-color: rgba(190, 194, 185, 0.16);
}

.lt-button--primary {
    background-color: rgb(65, 78, 67);
    border-color: rgba(183, 200, 178, 0.52);
}

.lt-button--primary:hover {
    background-color: rgb(79, 94, 81);
}

/* Unity's runtime DropdownField keeps its editor-like light painting even after the resolved colour is
   overridden. The shell below owns only the presentation; an invisible native field still owns input,
   focus and the popup, so selection logic is not duplicated. */
.lt-dropdown-readable-text {
    flex-grow: 1;
    height: 100%;
    padding-left: 12px;
    color: rgb(230, 233, 225);
    background-color: rgb(36, 42, 37);
    font-size: 13px;
    -unity-text-align: middle-left;
}

.lt-dropdown-readable-arrow {
    width: 24px;
    height: 100%;
    color: rgb(190, 198, 187);
    background-color: rgb(36, 42, 37);
    font-size: 11px;
    -unity-text-align: middle-center;
}

.lt-dropdown-shell {
    position: relative;
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    height: 34px;
    min-height: 34px;
    padding-left: 0;
    color: rgb(230, 233, 225);
    background-color: rgb(36, 42, 37);
    border-width: 1px;
    border-color: rgba(211, 216, 205, 0.34);
    border-radius: 2px;
}

.lt-dropdown-shell:hover {
    background-color: rgb(49, 57, 50);
    border-color: rgba(222, 226, 216, 0.54);
}

.lt-dropdown-shell:hover .lt-dropdown-readable-text,
.lt-dropdown-shell:hover .lt-dropdown-readable-arrow {
    background-color: rgb(49, 57, 50);
}

.lt-dropdown-shell:active .lt-dropdown-readable-text,
.lt-dropdown-shell:active .lt-dropdown-readable-arrow {
    background-color: rgb(30, 36, 31);
}

.lt-dropdown-shell--focus {
    border-color: rgb(151, 171, 145);
}

.lt-dropdown-native-hitbox {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
}

.unity-base-dropdown__container-inner {
    color: rgb(230, 233, 225);
    background-color: rgb(29, 34, 30);
    border-color: rgba(211, 216, 205, 0.42);
}

.lt-slider > .unity-base-field__label {
    color: rgb(226, 229, 221);
    font-size: 13px;
}

.lt-slider .unity-base-slider__track {
    background-color: rgb(25, 30, 26);
    border-width: 1px;
    border-color: rgba(205, 210, 200, 0.30);
}

.lt-slider .unity-base-slider__input {
    background-color: rgb(104, 128, 103);
}

.lt-slider .unity-base-slider__dragger {
    width: 12px;
    background-color: rgb(224, 228, 218);
    border-width: 1px;
    border-color: rgb(20, 24, 20);
}

.lt-slider .unity-base-text-field__input,
.lt-slider .unity-text-field__input {
    color: rgb(230, 233, 225);
    background-color: rgb(36, 42, 37);
    border-width: 1px;
    border-color: rgba(211, 216, 205, 0.34);
    -unity-text-align: middle-center;
}

Scroller #unity-tracker {
    background-color: rgb(20, 24, 21);
}

Scroller #unity-dragger {
    background-color: rgb(75, 87, 76);
}
