@import url("LocalTanksTheme.uss");

.main-menu {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    padding: 42px 72px 34px 72px;
    background-color: rgb(15, 18, 16);
    color: rgb(226, 229, 220);
}

.menu-header { flex-direction: row; justify-content: space-between; align-items: center; margin-bottom: 20px; }
.menu-title { font-size: 42px; -unity-font-style: bold; color: rgb(224, 183, 78); }
.menu-subtitle { font-size: 18px; }
.menu-settings { width: 150px; height: 38px; }
.map-panel { flex-direction: row; align-items: center; min-height: 58px; padding: 10px 18px; margin-bottom: 16px; flex-shrink: 0; }
.menu-section-title { width: 110px; }
.map-choice { flex-grow: 1; height: 36px; }
.teams-row {
    flex-direction: row;
    flex-grow: 1;
    min-height: 0;
    margin-bottom: 16px;
}
.team-panel { width: 49%; height: 100%; min-height: 0; padding: 18px; }
.team-a-panel { margin-right: 2%; }
.team-title { font-size: 19px; -unity-font-style: bold; margin-bottom: 12px; }
.team-count, .team-whole-row { min-height: 36px; margin-bottom: 10px; flex-shrink: 0; }
.team-whole-row { flex-direction: row; align-items: center; }
.team-whole-label { width: 154px; flex-shrink: 0; }
.team-whole { flex-grow: 1; height: 34px; }
.team-count > .unity-base-field__label,
.team-whole > .unity-base-field__label { width: 154px; color: rgb(226, 229, 221); }
.team-count .unity-base-slider__text-field { width: 58px; margin-left: 10px; }
.team-rows { flex-grow: 1; min-height: 0; }
.team-rows .unity-scroll-view__content-container { padding-right: 4px; }
.team-slot { flex-direction: row; align-items: center; min-height: 38px; margin-bottom: 6px; flex-shrink: 0; }
.team-slot-label { width: 82px; }
.team-slot-dropdown { flex-grow: 1; height: 34px; }
.menu-footer { align-items: center; justify-content: center; min-height: 52px; flex-shrink: 0; }
.play-button {
    width: 240px;
    height: 46px;
    font-size: 18px;
}
.launch-validation { color: rgb(239, 121, 98); -unity-text-align: middle-center; margin-bottom: 6px; }
.hidden { display: none; }
