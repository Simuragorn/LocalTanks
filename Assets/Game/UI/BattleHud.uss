@import url("LocalTanksTheme.uss");

.battle-hud {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.roster-panel {
    position: absolute;
    top: 18px;
    width: 258px;
    padding: 9px 10px 9px 10px;
}

.ally-panel {
    left: 18px;
    border-top-width: 2px;
    border-top-color: rgb(107, 148, 109);
}

.enemy-panel {
    right: 18px;
    border-top-width: 2px;
    border-top-color: rgb(160, 91, 91);
}

.score-panel {
    position: absolute;
    top: 18px;
    left: 50%;
    translate: -50% 0;
    flex-direction: row;
    padding: 7px 15px;
}

.score-side {
    min-width: 78px;
    align-items: center;
}

.score-number {
    font-size: 22px;
    -unity-font-style: bold;
}

.score-separator {
    color: rgb(190, 190, 185);
    font-size: 22px;
}

.score-health {
    font-size: 11px;
    -unity-font-style: bold;
    margin-top: -3px;
}

.base-status-list {
    position: absolute;
    top: 68px;
    left: 50%;    translate: -50% 0;
    width: 360px;
}

.base-status-row {
    margin-bottom: 5px;
    padding: 7px 10px;
}

.base-status-header {
    flex-direction: row;
    justify-content: space-between;
}

.base-status-title, .base-status-timer {
    font-size: 13px;
    -unity-font-style: bold;
}

.base-capture-track {
    height: 8px;
    margin-top: 4px;
}

.base-capture-fill { height: 100%; }

.ally-text, .ally-row .tank-name { color: rgb(120, 169, 123); }
.enemy-text, .enemy-row .tank-name { color: rgb(185, 104, 104); }

.roster-row {
    height: 40px;
    flex-direction: row;
    align-items: center;
    margin-bottom: 2px;
}

.enemy-row { justify-content: flex-end; }
.tank-icon { width: 34px; height: 34px; margin-left: 4px; margin-right: 4px; }
.class-icon { width: 15px; height: 15px; margin-left: 3px; margin-right: 3px; flex-shrink: 0; }
.tank-data { flex-grow: 1; min-width: 0; }
.tank-title { height: 17px; flex-direction: row; align-items: center; }
.ally-title { justify-content: flex-start; }
.enemy-title { justify-content: flex-end; }
.enemy-row .tank-name { -unity-text-align: upper-right; }

.tank-name {
    font-size: 12px;
    height: 17px;
    flex-grow: 1;
    min-width: 0;
    -unity-font-style: bold;
    overflow: hidden;
}

.health-number {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    color: rgb(242, 242, 235);
    padding-top: 1px;
    padding-bottom: 0;
    margin-top: 0;
    margin-bottom: 0;
    font-size: 12px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 1.25px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.88);
}

.health-track {
    height: 17px;
}

.health-fill { height: 100%; background-color: rgb(120, 169, 123); }
.enemy-row .health-fill { background-color: rgb(185, 104, 104); }
.destroyed-row { opacity: 0.32; }
.unspotted-row { opacity: 0.58; }

.battle-clock {
    position: absolute;
    top: 18px;
    right: 286px;
    align-items: flex-end;
    padding: 6px 12px;
}

/* Read from across the screen, and never wider than the time itself: the battle clock is the one number the
   player looks at without aiming at it first. */
.battle-timer {
    color: rgb(235, 235, 228);
    font-size: 24px;
    -unity-font-style: bold;
    -unity-text-align: middle-right;
}

/* The line under the clock appears only when the battle has a result, so a running battle stays quiet. */
.battle-result {
    display: none;
    color: rgb(226, 214, 176);
    font-size: 13px;
    -unity-text-align: middle-right;
    max-width: 260px;
    white-space: normal;
}

.battle-result.has-result { display: flex; }

.weapon-status {
    position: absolute;
    left: 50%;
    bottom: 24px;
    translate: -50% 0;
    min-width: 238px;
    padding: 7px 13px;
    align-items: center;
}

.weapon-ammo {
    color: rgb(235, 235, 228);
    font-size: 15px;
    -unity-font-style: bold;
}

.weapon-reload {
    color: rgb(190, 190, 180);
    font-size: 12px;
}

.weapon-reload.is-reloading {
    color: rgb(239, 190, 91);
}

.battle-chat {
    position: absolute;
    left: 18px;
    bottom: 22px;
    width: 510px;
    min-height: 34px;
    padding: 8px 10px;
}

.chat-history { max-height: 126px; }
.chat-line { color: rgb(224, 224, 214); font-size: 13px; margin-bottom: 3px; white-space: normal; }
.chat-line.team { color: rgb(136, 185, 139); }
.chat-compose { flex-direction: row; align-items: center; margin-top: 5px; }
.chat-compose.hidden { display: none; }
.chat-channel { width: 78px; height: 29px; margin-right: 4px; font-size: 10px; }
.chat-channel.selected { background-color: rgb(91, 118, 91); color: white; }
.chat-input { flex-grow: 1; height: 30px; }
.chat-send { width: 92px; height: 30px; margin-left: 5px; }
.chat-hint { color: rgba(205, 205, 195, 0.68); font-size: 11px; }

.result-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(7, 8, 7, 0.62);
}
.result-overlay.hidden { display: none; }
.result-panel { width: 520px; padding: 28px; align-items: center; }
.result-title { font-size: 34px; -unity-font-style: bold; color: rgb(224, 183, 78); }
.result-title.defeat { color: rgb(190, 92, 82); }
.result-title.draw { color: rgb(196, 196, 186); }
.result-reason { margin-top: 10px; margin-bottom: 22px; font-size: 16px; -unity-text-align: middle-center; }
.result-buttons { flex-direction: row; }
.result-button { width: 190px; height: 38px; margin-left: 5px; margin-right: 5px; }

.combat-screen-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.world-health-number {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    color: rgb(235, 235, 228);
    padding-top: 1px;
    padding-bottom: 0;
    margin-top: 0;
    margin-bottom: 0;
    font-size: 13px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 1.4px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.92);
}

.world-health-bar {
    position: absolute;
    background-color: rgba(18, 20, 18, 0.94);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(218, 218, 205, 0.42);
    border-right-color: rgba(218, 218, 205, 0.42);
    border-top-color: rgba(218, 218, 205, 0.42);
    border-bottom-color: rgba(218, 218, 205, 0.42);
}

.world-health-fill {
    height: 100%;
}

.damage-popup {
    position: absolute;
    width: 90px;
    height: 28px;
    font-size: 22px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.95);
}

.damage-popup--enemy {
    color: rgb(255, 82, 82);
}

.damage-popup--ally {
    color: rgb(90, 196, 255);
}

.offscreen-indicator {
    position: absolute;
    width: 176px;
    height: 52px;
    align-items: center;
}

.offscreen-arrow {
    height: 27px;
    color: rgb(220, 115, 105);
    font-size: 27px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.95);
}

.offscreen-details {
    height: 25px;
    padding-left: 6px;
    padding-right: 6px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.offscreen-class-icon {
    width: 16px;
    height: 16px;
    margin-right: 5px;
}

.offscreen-text {
    color: rgb(235, 235, 228);
    font-size: 12px;
    -unity-font-style: bold;
}
