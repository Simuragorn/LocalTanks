<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:template="UnityEngine.UIElements">
    <ui:Template name="SettingsOverlay" src="project://database/Assets/Game/UI/SettingsOverlay.uxml" />
    <ui:VisualElement name="battle-hud" class="battle-hud">
        <ui:VisualElement name="ally-list" class="roster-panel ally-panel" />
        <ui:VisualElement name="score" class="score-panel">
            <ui:VisualElement class="score-side">
                <ui:Label name="ally-score" text="0" class="score-number ally-text" />
                <ui:Label name="ally-health-total" text="0 / 0" class="score-health ally-text" />
            </ui:VisualElement>
            <ui:Label text=" : " class="score-separator" />
            <ui:VisualElement class="score-side">
                <ui:Label name="enemy-score" text="0" class="score-number enemy-text" />
                <ui:Label name="enemy-health-total" text="0 / 0" class="score-health enemy-text" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="base-status-list" class="base-status-list" />
        <ui:VisualElement name="enemy-list" class="roster-panel enemy-panel" />

        <!-- The clock is always visible and the result replaces nothing: the timer keeps the value the battle
             ended with, so the player can see how long it lasted. Both are filled by BattleHudController from
             BattleDirector, which is the only thing that decides that the battle is over. -->
        <ui:VisualElement name="battle-clock" class="battle-clock">
            <ui:Label name="battle-timer" text="--:--" class="battle-timer" />
            <ui:Label name="battle-result" text="" class="battle-result" />
        </ui:VisualElement>

        <ui:VisualElement name="weapon-status" class="weapon-status">
            <ui:Label name="weapon-ammo" text="Снаряды  0 / 0" class="weapon-ammo" />
            <ui:Label name="weapon-reload" text="Перезарядка  0.0 с" class="weapon-reload" />
        </ui:VisualElement>

        <!-- The settings overlay is a template so its markup has one definition shared with the test
             range. It belongs to this document so it draws above the roster panels; a second
             UIDocument would get its own panel and the order between panels would decide layering.
             The instance carries a class because a template container does not stretch by itself: an
             absolutely positioned overlay inside it would resolve its insets against a zero-height box
             and squeeze every row on top of the next. -->
        <ui:Instance template="SettingsOverlay" name="settings-instance" class="settings-instance" />
    </ui:VisualElement>
</ui:UXML>
