/* Settings overlay styles. Shared by every scene: the battle HUD and the test range both load this
   sheet, so the panel looks the same wherever it appears. */

.settings-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(4, 6, 5, 0.62);
}

.settings-overlay.hidden { display: none; }

.settings-panel {
    width: 460px;
    padding: 18px 20px 16px 20px;
    background-color: rgba(15, 18, 16, 0.96);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(200, 200, 190, 0.22);
}

.settings-title {
    font-size: 20px;
    -unity-font-style: bold;
    margin-bottom: 14px;
}

.settings-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 10px;
}

.settings-label {
    width: 150px;
    font-size: 14px;
}

.settings-slider {
    flex-grow: 1;
    margin-right: 10px;
}

.settings-value {
    width: 52px;
    font-size: 14px;
    -unity-text-align: upper-right;
}

.settings-hint-row { margin-top: 2px; margin-bottom: 14px; }

.settings-hint {
    font-size: 11px;
    color: rgb(150, 152, 146);
    white-space: normal;
}

.settings-button-row {
    flex-direction: row;
    justify-content: flex-end;
}

.settings-button {
    width: 190px;
    height: 30px;
    margin-left: 8px;
    font-size: 13px;
}
